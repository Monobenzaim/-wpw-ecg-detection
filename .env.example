# ============================================================
# WPW ECG Detection - Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git!
#
# Usage:
#   cp .env.example .env
#   nano .env  # or use your favorite editor
# ============================================================

# ============================================================
# GROQ API CONFIGURATION
# ============================================================
# Get your free API key at: https://console.groq.com/keys
# Used for AI-powered medical explanations with Llama 3.1 LLM
GROQ_API_KEY=your_groq_api_key_here

# ============================================================
# OPTIONAL: OTHER LLM PROVIDERS
# ============================================================
# Uncomment and add keys if using alternative LLM providers
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# COHERE_API_KEY=your_cohere_api_key_here

# ============================================================
# APPLICATION SETTINGS
# ============================================================
# Debug mode (True/False)
DEBUG=False

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ============================================================
# MODEL CONFIGURATION
# ============================================================
# Default model to use for predictions
DEFAULT_MODEL=random_forest_wpw.pkl

# Random seed for reproducibility
RANDOM_STATE=42

# ============================================================
# PATHS (OPTIONAL - DEFAULTS ARE USUALLY FINE)
# ============================================================
# Uncomment to override default paths
# DATA_PATH=./data/wpw_dataset_features.csv
# MODELS_DIR=./models
# REPORTS_DIR=./reports
# BENCHMARK_DIR=./benchmark_results

# ============================================================
# DATABASE (IF USING FOR PRODUCTION)
# ============================================================
# Uncomment if storing results in database
# DATABASE_URL=postgresql://user:password@localhost:5432/wpw_db
# REDIS_URL=redis://localhost:6379/0

# ============================================================
# DEPLOYMENT (PRODUCTION SETTINGS)
# ============================================================
# Uncomment for production deployment
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_ADDRESS=0.0.0.0
# STREAMLIT_SERVER_HEADLESS=true
# STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# ============================================================
# SECURITY (PRODUCTION)
# ============================================================
# Uncomment for production
# SECRET_KEY=your_secret_key_for_session_management
# ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
# CORS_ORIGINS=https://yourdomain.com

# ============================================================
# MONITORING & ANALYTICS (OPTIONAL)
# ============================================================
# Uncomment if using monitoring services
# SENTRY_DSN=your_sentry_dsn_here
# GOOGLE_ANALYTICS_ID=UA-XXXXX-Y

# ============================================================
# EMAIL NOTIFICATIONS (OPTIONAL)
# ============================================================
# Uncomment for email alerts
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# ALERT_EMAIL=admin@example.com

# ============================================================
# NOTES
# ============================================================
# 1. After adding your keys, verify the .env file is in .gitignore
# 2. Never share your .env file or commit it to version control
# 3. For production, use secure secret management (AWS Secrets Manager, etc.)
# 4. Rotate API keys regularly
# 5. Use different keys for development and production
